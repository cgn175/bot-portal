# CopilotKit Sidecar Configuration

# Port for the sidecar server
COPILOT_PORT=3001

# Bot Portal Go backend URL
BACKEND_URL=http://localhost:8080

# CORS allowed origins (comma-separated if multiple)
CORS_ORIGIN=http://localhost:3100,http://localhost:5173

# Default model ID from Bot Portal database
# This model will be used if CopilotKit doesn't specify one
DEFAULT_MODEL=gpt-4o
